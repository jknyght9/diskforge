{
  "name": "windows10",
  "description": "Windows 10/11 NTFS directory structure with forensic-relevant paths",
  "recommended_filesystem": "ntfs",
  "directories": [
    "Windows/System32",
    "Windows/System32/config",
    "Windows/System32/config/RegBack",
    "Windows/System32/winevt/Logs",
    "Windows/System32/Tasks",
    "Windows/System32/drivers/etc",
    "Windows/System32/sru",
    "Windows/SysWOW64",
    "Windows/Prefetch",
    "Windows/Temp",
    "Windows/INF",
    "Windows/appcompat/Programs",
    "Windows/ServiceProfiles/LocalService",
    "Windows/ServiceProfiles/NetworkService",
    "Program Files",
    "Program Files/Common Files",
    "Program Files/Windows Defender",
    "Program Files (x86)",
    "Program Files (x86)/Common Files",
    "ProgramData/Microsoft/Windows/Start Menu/Programs/Startup",
    "Users/Default/Documents",
    "Users/Default/Desktop",
    "Users/Default/Downloads",
    "Users/Default/AppData/Local",
    "Users/Default/AppData/Local/Microsoft/Windows/Explorer",
    "Users/Default/AppData/Local/Microsoft/Windows/UsrClass.dat",
    "Users/Default/AppData/Local/ConnectedDevicesPlatform",
    "Users/Default/AppData/Roaming/Microsoft/Windows/Recent",
    "Users/Default/AppData/Roaming/Microsoft/Windows/PowerShell/PSReadLine",
    "Users/Public/Documents",
    "Users/Public/Desktop",
    "Users/Public/Downloads",
    "$Recycle.Bin",
    "System Volume Information",
    "Recovery"
  ],
  "files": {
    "Windows/System32/config/SAM": { "type": "empty" },
    "Windows/System32/config/SYSTEM": { "type": "empty" },
    "Windows/System32/config/SOFTWARE": { "type": "empty" },
    "Windows/System32/config/SECURITY": { "type": "empty" },
    "Windows/System32/config/DEFAULT": { "type": "empty" },
    "Windows/System32/drivers/etc/hosts": { "type": "empty" },
    "Windows/System32/sru/SRUDB.dat": { "type": "empty" },
    "Users/Default/NTUSER.DAT": { "type": "empty" },
    "Windows/bootmgr": { "type": "empty" },
    "Windows/System32/cmd.exe": { "type": "empty" },
    "Windows/System32/powershell.exe": { "type": "empty" },
    "Windows/System32/notepad.exe": { "type": "empty" },
    "Windows/explorer.exe": { "type": "empty" },
    "pagefile.sys": { "type": "zero_fill", "size": 4096 },
    "hiberfil.sys": { "type": "zero_fill", "size": 4096 },
    "Windows/appcompat/Programs/Amcache.hve": { "type": "empty" },
    "$MFT": { "type": "empty" }
  }
}
