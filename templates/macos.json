{
  "name": "macos",
  "description": "macOS HFS+ directory structure with forensic-relevant paths",
  "recommended_filesystem": "hfsplus",
  "directories": [
    "Applications",
    "Library",
    "Library/Application Support",
    "Library/LaunchAgents",
    "Library/LaunchDaemons",
    "Library/Logs",
    "Library/Preferences",
    "Library/StartupItems",
    "System",
    "System/Library",
    "System/Library/CoreServices",
    "System/Library/Extensions",
    "System/Library/LaunchAgents",
    "System/Library/LaunchDaemons",
    "Users",
    "Users/Shared",
    "Users/Guest",
    "Volumes",
    "bin",
    "etc",
    "private/etc",
    "private/var/log",
    "private/var/db",
    "private/var/folders",
    "private/tmp",
    "sbin",
    "tmp",
    "usr/bin",
    "usr/lib",
    "usr/local/bin",
    "usr/sbin",
    "var/log"
  ],
  "files": {
    "private/etc/passwd": { "type": "empty" },
    "private/etc/hosts": { "type": "empty" },
    "private/etc/fstab": { "type": "empty" },
    "private/var/log/system.log": { "type": "empty" },
    "private/var/log/install.log": { "type": "empty" },
    "private/var/log/wifi.log": { "type": "empty" },
    "private/var/db/dslocal/nodes/Default/users": { "type": "empty" },
    "private/var/db/.AppleSetupDone": { "type": "empty" },
    "Library/Preferences/.GlobalPreferences.plist": { "type": "empty" },
    "Library/Preferences/com.apple.loginwindow.plist": { "type": "empty" },
    "System/Library/CoreServices/SystemVersion.plist": { "type": "empty" },
    ".fseventsd/fseventsd-uuid": { "type": "empty" },
    ".Spotlight-V100/store.db": { "type": "empty" }
  }
}
